{
    "compileOnSave": true,
    "include": ["./src/**/*", "./capacitor.config.ts", "./capacitor.config.js"],
    "compilerOptions": {
        "skipLibCheck": true,
        "outDir": "./build",
        "importHelpers": false,
        "target": "ES2017",
        "module": "CommonJS",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "typeRoots": ["./node_modules/@types"],
        "allowJs": true,
        "rootDir": "."
    }
}
