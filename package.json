{
    "name": "Paradise",
    "version": "0.37.4",
    "config": {
        "build": "42"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Paradise-Chat/Paradise"
    },
    "scripts": {
        "notangle": "concurrently \"npx shadow-cljs watch app\" \"npx vite\"",
        "dev": "concurrently \"npx shadow-cljs watch app\" \"npx nbb tangler.cljs\" \"npx vite\"",
        "me": "concurrently \"npx shadow-cljs watch app\" \"npx nbb tangler.cljs\" \"npx vite\"",
        "release": "npx shadow-cljs release app && npx vite build",
        "serve": "npx serve -s dist -l 8000",
        "prep": "clojure -X:deps prep",
        "ubrn:web:build:release": "PATH=$HOME/.cargo/bin:/bin:$PATH && ubrn build web --config ubrn.config.yaml --release",
        "ubrn:web:build": "PATH=$HOME/.cargo/bin:/bin:$PATH && ubrn build web --config ubrn.config.yaml",
        "ubrn:checkout": "PATH=$HOME/.cargo/bin:/bin:$PATH && ubrn checkout --config ubrn.config.yaml",
        "ubrn:clean": "rm -Rf cpp/ src/generated/ src/index.web.ts*",
        "cap:generate": "npx capacitor-assets generate",
        "ad:add": "npx cap add android",
        "ios:add": "npx cap add ios",
        "ios:sync": "npx cap sync ios",
        "ad:sync": "npx cap sync android",
        "ios:copy": "npx cap copy ios",
        "ad:copy": "npx cap copy android",
        "version:ios": "npx capacitor-set-version set:ios -v $npm_package_version -b $npm_package_config_build",
        "version:android": "npx capacitor-set-version set:android -v $npm_package_version -b $npm_package_config_build",
        "config:ios": ". ./.env && TEAM_ID=$APPLE_TEAM_ID npx trapeze run trapeze.yaml -y --ios",
        "version:sync": "npm run version:ios && npm run version:android && npm run config:ios",
        "electron:make": "npm run electron:make --prefix electron",
        "guix:electron:make": "guix shell -FCN -m ./electron-manifest.scm -- npm run electron:make --prefix electron"
    },
    "dependencies": {
        "@capacitor-community/electron": "^5.0.1",
        "@capacitor/android": "^8.4.1",
        "@capacitor/app": "^8.1.0",
        "@capacitor/browser": "^8.0.3",
        "@capacitor/cli": "^8.4.1",
        "@capacitor/core": "^8.4.1",
        "@capacitor/ios": "^8.4.1",
        "@capacitor/keyboard": "^8.0.3",
        "@capacitor/push-notifications": "^8.0.3",
        "@chenglou/pretext": "^0.0.4",
        "@element-hq/element-call-embedded": "npm:@gigia/element-call-embedded@0.20.3-denoise.4",
        "@livekit/components-react": "^2.9.23",
        "@livekit/components-styles": "^1.2.0",
        "@tiptap/core": "^3.20.0",
        "@tiptap/extension-link": "^3.31.3",
        "@tiptap/extension-mention": "^3.20.0",
        "@tiptap/extension-placeholder": "^3.20.0",
        "@tiptap/react": "^3.20.0",
        "@tiptap/starter-kit": "^3.20.0",
        "@tiptap/suggestion": "^3.20.0",
        "@xmldom/xmldom": "^0.9.10",
        "emojibase-data": "^17.0.0",
        "ffi-bindings": "^1.0.6",
        "livekit-client": "^2.21.0",
        "matrix-widget-api": "^1.17.0",
        "nbb": "^1.4.206",
        "react": "^19",
        "react-dom": "^19",
        "react-virtuoso": "^4.18.1",
        "shadow-cljs": "^3.3.6",
        "typescript": "^5.9.3",
        "unicode-emoji-json": "^0.8.0",
        "virtua": "^0.48.8",
        "workbox-precaching": "^7.4.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.28.6",
        "@babel/core": "^7.29.0",
        "@babel/plugin-transform-class-properties": "^7.28.6",
        "@babel/plugin-transform-computed-properties": "^7.28.6",
        "@babel/preset-env": "^7.29.0",
        "@babel/preset-typescript": "^7.28.5",
        "@capacitor/assets": "^3.0.5",
        "@trapezedev/configure": "^7.1.3",
        "babel-plugin-transform-rename-import": "^2.3.0",
        "capacitor-set-version": "^2.2.0",
        "concurrently": "^9.2.1",
        "vite": "^7.3.1",
        "vite-plugin-commonjs": "^0.10.4",
        "vite-plugin-pwa": "^1.2.0",
        "vite-plugin-static-copy": "^3.2.0",
        "vite-plugin-top-level-await": "^1.6.0",
        "vite-plugin-wasm": "^3.5.0"
    },
    "resolutions": {
        "sharp": "^0.33.3"
    }
}
