{:deps {:aliases [:dev]}
 :builds
 {:app {:target :esm
        :npm-deps false
        :build-hooks [[virtualizer.lifter/hook
                       {:src-dir         "src"
                        :out-dir         "src-gen"
                        :registry-ns     virtualizer.registry
                        :skip-namespaces #{virtualizer.registry
                                           virtualizer.protocol
                                           virtualizer.core
                                           virtualizer.scroll
                                           virtualizer.metrics
                                           virtualizer.layout
                                           virtualizer.client.hydrator
                                           virtualizer.worker.ast
                                           virtualizer.worker.engine
                                           virtualizer.worker.pretext
                                           paradise.shared.utils.macros
                                           paradise.shared.client.registry
                                           paradise.shared.client.state
                                           paradise.shared.client.core
                                           paradise.virtualizer.base
                                           paradise.virtualizer.spec
                                           paradise.virtualizer.parsing
                                           paradise.ui.container.timeline.hydrator
                                           re-frame.db
                                           net}}]
                      [build-hooks/include-root-files]
                      [build-hooks/include-themes]
                      [build-hooks/stamp-version]
                      [build-hooks/include-css]
                      [build-hooks/fetch-community-registry]
                      [build-hooks/copy-runtime-assets]]
        :output-dir "build"
        :asset-path "/"
        :modules {:base {:entries [virtualizer.registry
                                   virtualizer.protocol]}
                  :main {:entries [paradise.shared.client.core]
                         :depends-on #{:base}
                         :exports {init paradise.shared.client.core/init}}
                  :sw {:entries [service-worker]
                       :web-worker true
                       :depends-on #{:base}}
                  :media {:entries [paradise.media.core]
                          :web-worker true
                          :depends-on #{:base}}
                  :engine {:entries [paradise.engine.core]
                           :web-worker true
                           :depends-on #{:base}}
                  :virtualizer {:entries [virtualizer.worker.dom-shim
                                          paradise.virtualizer.base]
                                :web-worker true
                                :depends-on #{:base}}}

        :js-options
        {:js-provider :import
         :esm-js-shim false
         :loader {".css" :css}}
        :compiler-options
        {:optimizations :simple
         :pretty-print true
         :output-feature-set :es-next
         :warnings {:undeclared-ns false
                    :undeclared-var false
                    :infer-warning false}}
        :devtools {:after-load paradise.shared.client.core/after-load
                   :watch-dir "docs"
                   ;;:devtools-url "."
                   }}}}
